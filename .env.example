GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.7-flash

LINE_CHANNEL_SECRET=your-line-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token

FIRESTORE_UNKNOWN_QUESTION_COLLECTION=unknown_questions
# Server-only logs for website and LINE questions; defaults to chat_logs.
FIRESTORE_CHAT_LOG_COLLECTION=chat_logs
FIRESTORE_WEBSITE_MESSAGE_COLLECTION=website_messages
FIRESTORE_MESSAGE_RATE_LIMIT_COLLECTION=website_message_rate_limits
WEBSITE_MESSAGE_RATE_LIMIT=5

# 網站 AI 問答的伺服器端限流（同一訪客每小時可成功進入處理的次數）。
FIRESTORE_CHAT_RATE_LIMIT_COLLECTION=chat_rate_limits
CHAT_RATE_LIMIT_PER_HOUR=20
# 建議使用獨立的長隨機字串；未設定時會向下相容地沿用 LINE_CHANNEL_SECRET。
CHAT_RATE_LIMIT_HASH_SECRET=replace-with-a-long-random-secret

# Cloudflare Turnstile：site key 放在 Astro，這裡只放 secret key。
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
# 選填；未設定時會從 CORS_ALLOWED_ORIGINS 自動取得 hostname。
TURNSTILE_ALLOWED_HOSTNAMES=localhost,your-domain.example

CORS_ALLOWED_ORIGINS=http://localhost:4321,https://your-site.pages.dev
PORT=8080
